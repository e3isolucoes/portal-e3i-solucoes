# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Configuration (E3I AF01-R2)
AI_FEATURES_ENABLED="true"
AI_PROVIDER="gemini"
GEMINI_MODEL_FAST="gemini-2.5-flash"
GEMINI_MODEL_BALANCED="gemini-2.5-flash"
AI_DEFAULT_MAX_OUTPUT_TOKENS="2048"
AI_REQUEST_TIMEOUT_MS="30000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PORT=3000
NODE_ENV=production
# O portal opera por concessão. Mantenha falso em ambientes públicos.
ALLOW_PUBLIC_REGISTRATION=false

# Pesquisa real de compras. Guarde chaves apenas no cofre de segredos do ambiente.
PROCUREMENT_REAL_SEARCH_ENABLED=false
PROCUREMENT_RESULT_LIMIT=30
PROCUREMENT_CACHE_MINUTES=30
PROCUREMENT_REQUEST_TIMEOUT_MS=20000
SERPAPI_ENABLED=false
SERPAPI_API_KEY=
SERPAPI_LOCATION=Brazil
SERPAPI_GL=br
SERPAPI_HL=pt

# Entrega transacional para recuperação de senha (Resend ou API compatível).
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=E3I Soluções <acesso@e3isolucoes.com.br>
PASSWORD_RESET_TOKEN_TTL_MINUTES=30


# Persistence Providers (E3I SR-02 GCP)
DATABASE_URL="file:./dev.db"
OPERATIONAL_PERSISTENCE_PROVIDER=firestore
ANALYTICAL_PERSISTENCE_PROVIDER=bigquery
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)
BIGQUERY_DATASET=
BIGQUERY_LOCATION=
# Endereços publicados das ferramentas do portal do cliente.
# Sem estas variáveis, o servidor usa caminhos relativos em /ferramentas/.
GESTAO_COMPRAS_URL=https://compras.seu-dominio.com.br/
PAINEL_OBRIGACOES_URL=https://obrigacoes.seu-dominio.com.br/
PAINEL_SUPABASE_URL=https://seu-projeto.supabase.co
PAINEL_SUPABASE_SERVICE_ROLE_KEY=
